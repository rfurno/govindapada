# Shared class password. Required in production. If unset in development, the gate is open.
KATHA_PASSWORD=

# Signs the session cookie. Required whenever KATHA_PASSWORD is set.
AUTH_SECRET=

# Library. Without these, the board loads and Criar explains that the library is not configured.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional overrides for the local generator.
# Unset GROK_MODEL uses grok-4.7-build-fast. Unset GROK_EFFORT uses low.
# GROK_BIN=
# GROK_MODEL=grok-4.7
# GROK_EFFORT=medium
